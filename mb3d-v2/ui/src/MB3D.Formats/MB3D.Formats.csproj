<Project Sdk="Microsoft.NET.Sdk">

  <!--
    SPDX-License-Identifier: LicenseRef-MB3D-V2-Proprietary
    Copyright (c) 2026 KenTread. All Rights Reserved.

    Managed import surface for the legacy file suite.

    Identification and version peeking are pure managed code so a
    drag-and-drop handler works before the native core is loaded; the
    actual parse is delegated to MB3D_Core, which is the single hardened
    implementation.
  -->

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>13.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsAotCompatible>true</IsAotCompatible>
    <RootNamespace>MB3D.Formats</RootNamespace>
    <AssemblyName>MB3D.Formats</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\MB3D.Interop\MB3D.Interop.csproj" />
  </ItemGroup>

</Project>
