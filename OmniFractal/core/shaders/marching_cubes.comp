//
// marching_cubes.comp -- GPU iso-surface extraction.
//
// Uses the same six-tetrahedra decomposition as MarchingCubes.cpp, for
// the same reason: no ambiguous cases means the mesh is manifold by
// construction, and a shared edge yields the identical interpolated
// vertex from either neighbouring cell, so the result is watertight.
//
// Output is a raw triangle-soup vertex buffer plus an atomic counter.
// De-duplication happens host-side in Mesh::weld() -- doing it on the
// GPU would need a hash map in shared memory and buys nothing, since the
// weld pass is a fraction of a percent of total export time.
//
// Two dispatches:
//   pass 0 (COUNT) -- count triangles so the host can size the buffer
//   pass 1 (EMIT)  -- write them
// Counting first avoids either over-allocating for a 1024^3 grid or
// silently truncating the mesh when the guess is too small.

#version 450

layout(local_size_x = 4, local_size_y = 4, local_size_z = 4) in;

layout(set = 0, binding = 0, std430) readonly buffer FieldBuffer {
    // Distance-estimator samples on the (nx+1)*(ny+1)*(nz+1) lattice for
    // the slab currently being processed.
    float value[];
} field;

layout(set = 0, binding = 1, std430) buffer CounterBuffer {
    uint triangle_count;
} counter;

layout(set = 0, binding = 2, std430) writeonly buffer VertexBuffer {
    // Three vec4 per triangle; w is unused padding to keep the stride at
    // 16 bytes, which every GPU we target prefers over a packed vec3.
    vec4 vertex[];
} vertices;

layout(push_constant) uniform PushConstants {
    ivec4 resolution;      // nx, ny, nz, slab_z0
    vec4  bounds_min;
    vec4  cell_size;
    float iso_level;
    int   pass_index;      // 0 = count, 1 = emit
    int   max_triangles;
    int   _pad;
} pc;

// Cube corner offsets, matching kCorner[] in MarchingCubes.cpp.
const ivec3 CORNER[8] = ivec3[8](
    ivec3(0, 0, 0), ivec3(1, 0, 0), ivec3(1, 1, 0), ivec3(0, 1, 0),
    ivec3(0, 0, 1), ivec3(1, 0, 1), ivec3(1, 1, 1), ivec3(0, 1, 1));

// Six tetrahedra sharing the (0,6) diagonal, matching kTetra[].
const int TETRA[6][4] = int[6][4](
    int[4](0, 5, 1, 6), int[4](0, 1, 2, 6), int[4](0, 2, 3, 6),
    int[4](0, 3, 7, 6), int[4](0, 7, 4, 6), int[4](0, 4, 5, 6));

const int TET_EDGE[6][2] = int[6][2](
    int[2](0, 1), int[2](0, 2), int[2](0, 3),
    int[2](1, 2), int[2](1, 3), int[2](2, 3));

// Edge triples per inside/outside pattern, matching kTetTri[].
const int TET_TRI[16][7] = int[16][7](
    int[7](-1, -1, -1, -1, -1, -1, -1),
    int[7]( 0,  1,  2, -1, -1, -1, -1),
    int[7]( 0,  3,  4, -1, -1, -1, -1),
    int[7]( 1,  2,  4,  1,  4,  3, -1),
    int[7]( 1,  3,  5, -1, -1, -1, -1),
    int[7]( 0,  2,  5,  0,  5,  3, -1),
    int[7]( 0,  1,  5,  0,  5,  4, -1),
    int[7]( 2,  5,  4, -1, -1, -1, -1),
    int[7]( 2,  4,  5, -1, -1, -1, -1),
    int[7]( 0,  4,  5,  0,  5,  1, -1),
    int[7]( 0,  5,  3,  0,  2,  5, -1),
    int[7]( 1,  5,  3, -1, -1, -1, -1),
    int[7]( 1,  4,  3,  1,  2,  4, -1),
    int[7]( 0,  4,  3, -1, -1, -1, -1),
    int[7]( 0,  2,  1, -1, -1, -1, -1),
    int[7](-1, -1, -1, -1, -1, -1, -1));

int field_index(ivec3 g) {
    return (g.z * pc.resolution.y + g.y) * pc.resolution.x + g.x;
}

vec3 world_position(ivec3 g) {
    return pc.bounds_min.xyz + vec3(g) * pc.cell_size.xyz;
}

void main() {
    ivec3 cell = ivec3(gl_GlobalInvocationID);
    if (cell.x + 1 >= pc.resolution.x ||
        cell.y + 1 >= pc.resolution.y ||
        cell.z + 1 >= pc.resolution.z) return;

    float value[8];
    vec3  point[8];
    for (int c = 0; c < 8; ++c) {
        ivec3 g = cell + CORNER[c];
        value[c] = field.value[field_index(g)];
        point[c] = world_position(g);
    }

    for (int t = 0; t < 6; ++t) {
        int pattern = 0;
        for (int v = 0; v < 4; ++v) {
            if (value[TETRA[t][v]] < pc.iso_level) pattern |= (1 << v);
        }
        if (TET_TRI[pattern][0] < 0) continue;

        for (int i = 0; TET_TRI[pattern][i] >= 0; i += 3) {
            if (pc.pass_index == 0) {
                atomicAdd(counter.triangle_count, 1u);
                continue;
            }

            uint slot = atomicAdd(counter.triangle_count, 1u);
            if (slot >= uint(pc.max_triangles)) return;

            for (int k = 0; k < 3; ++k) {
                int edge = TET_TRI[pattern][i + k];
                int ca = TETRA[t][TET_EDGE[edge][0]];
                int cb = TETRA[t][TET_EDGE[edge][1]];

                float va = value[ca];
                float vb = value[cb];
                float denom = vb - va;
                // The 0.5 fallback keeps a flat-valued edge from
                // producing a NaN vertex, which would poison the whole
                // exported mesh.
                float f = abs(denom) < 1e-20 ? 0.5
                                             : clamp((pc.iso_level - va) / denom, 0.0, 1.0);
                vec3 p = mix(point[ca], point[cb], f);
                vertices.vertex[slot * 3u + uint(k)] = vec4(p, 1.0);
            }
        }
    }
}
